diff --git a/app/public/game/controle.html b/app/public/game/controle.html
new file mode 100644
index 0000000..ab20c7a
--- /dev/null
+++ b/app/public/game/controle.html
@@ -0,0 +1,41 @@
+<!DOCTYPE html>
+<html lang="pt-BR">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Teste de controle — RACHA</title>
+<style>
+  body { background:#12102b; color:#fff; font-family:system-ui,sans-serif; text-align:center; padding:24px; }
+  h1 { color:#ffd23f; font-size:22px; }
+  .pad { background:#1b1540; border:2px solid #33286b; border-radius:14px; padding:14px; margin:14px auto; max-width:560px; }
+  .grid { display:grid; grid-template-columns:repeat(6,1fr); gap:8px; margin-top:10px; }
+  .b { background:#0c0a20; border:2px solid #33286b; border-radius:10px; padding:10px 4px; font-size:13px; }
+  .b.on { background:#2f9e44; border-color:#7be04a; font-weight:bold; }
+  .axes { font-family:monospace; margin-top:10px; color:#b0a6e8; }
+  .dica { color:#b0a6e8; font-size:14px; }
+</style>
+</head>
+<body>
+<h1>🎮 Teste de controle</h1>
+<p class="dica">Aperte qualquer botão do controle para ele aparecer.<br>Depois aperte <b>X</b> e <b>quadrado</b> (ou A e X no Xbox) e veja quais números acendem.</p>
+<div id="saida"><p class="dica">Nenhum controle detectado ainda…</p></div>
+<script>
+const saida = document.getElementById('saida');
+function desenhar(){
+  const pads = navigator.getGamepads ? Array.from(navigator.getGamepads()).filter(p => p && p.connected) : [];
+  if (!pads.length){ saida.innerHTML = '<p class="dica">Nenhum controle detectado ainda…</p>'; }
+  else {
+    saida.innerHTML = pads.map(p => `
+      <div class="pad">
+        <div><b>${p.id}</b></div>
+        <div class="dica">mapping: "${p.mapping || 'vazio (não-padrão)'}" · ${p.buttons.length} botões · ${p.axes.length} eixos</div>
+        <div class="axes">analógico: ${p.axes.map(a => a.toFixed(2)).join(' · ')}</div>
+        <div class="grid">${p.buttons.map((b, i) => `<div class="b ${b.pressed ? 'on' : ''}">${i}</div>`).join('')}</div>
+      </div>`).join('');
+  }
+  requestAnimationFrame(desenhar);
+}
+desenhar();
+</script>
+</body>
+</html>
